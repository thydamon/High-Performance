Debug/
Release/
x64/
x86/

# Ignore IDE files
.vs/
.vscode/
.claude/
*.sln
*.vcxproj
*.vcxproj.user
*.code-workspace

# Ignore other generated files
*.pdb
*.ilk
*.exp
*.manifest

# Ignore node cache
node_cache/
