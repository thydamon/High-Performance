# Ignore compiled executables
*.exe
*.out
*.app

# Ignore object files and static/dynamic libraries
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib

# Ignore build directories
build/
build-*/
cmake-build-*/
